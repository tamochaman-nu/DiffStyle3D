# Copy to .env and edit:  cp .env.example .env
# Paths and private values only. Training configs are in docker-compose.yml.
# Relative paths are resolved from this directory. Create the directories
# beforehand, otherwise Docker creates them owned by root.

# --- user (files in the output dirs are written with this uid/gid; check with `id`) ---
HOST_UID=1000
HOST_GID=1000

# --- host directories (mounted into the container) ---
# Root of the COLMAP datasets, e.g. <DATA_DIR>/tandt/truck/{images,sparse}  -> /data
DATA_DIR=./data
# 3DGS reconstructions; train-style reads <GS_OUTPUT_DIR>/<SCENE>/chkpnt30000.pth  -> /gs_output
GS_OUTPUT_DIR=./output/3dgs
# Stylization results: <STYLE_OUTPUT_DIR>/<SCENE>/<EXP_NAME>  -> /style_output
STYLE_OUTPUT_DIR=./output/style
# Style reference images  -> /styles
STYLE_DIR=./style_image
# Stable Diffusion weights (written by download-sd)  -> /models
MODELS_DIR=./models
# Hugging Face cache  -> /cache/huggingface
HF_CACHE_DIR=./cache/huggingface

# --- target selection ---
# Scene directory relative to DATA_DIR
SCENE=tandt/truck
# Only for prepare-scene: source scene whose views have different sizes.
# It is resized and written to DATA_DIR/SCENE (e.g. RAW_SCENE=sample02, SCENE=sample02_576x1024)
RAW_SCENE=
# Style image file relative to STYLE_DIR
STYLE_IMAGE=1.png
# Output sub-directory name for this stylization run
EXP_NAME=style1

# --- secrets ---
# Only needed for gated / private Hugging Face models
HF_TOKEN=
